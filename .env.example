# Skopíruj do súboru .env a doplň hodnoty zo Supabase (Project Settings → API).
# Používaj iba publishable / "anon public" kľúč. Service role kľúč sem NIKDY nedávaj.
# Bez týchto hodnôt beží appka v demo režime (dáta iba v tomto prehliadači).
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=
